rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function authenticatedEmailUser() {
      return request.auth != null && request.auth.token.email != null;
    }

    function hasCanonicalAppAccess(uid, appId) {
      return signedInAs(uid)
        && exists(/databases/$(database)/documents/accessUsers/$(uid))
        && get(/databases/$(database)/documents/accessUsers/$(uid)).data.active == true
        && 'apps' in get(/databases/$(database)/documents/accessUsers/$(uid)).data
        && appId in get(/databases/$(database)/documents/accessUsers/$(uid)).data.apps
        && get(/databases/$(database)/documents/accessUsers/$(uid)).data.apps[appId] == true
        && (
          !('appExpirations' in get(/databases/$(database)/documents/accessUsers/$(uid)).data)
          || !(appId in get(/databases/$(database)/documents/accessUsers/$(uid)).data.appExpirations)
          || get(/databases/$(database)/documents/accessUsers/$(uid)).data.appExpirations[appId] > request.time
        )
        && exists(/databases/$(database)/documents/appRegistry/$(appId))
        && get(/databases/$(database)/documents/appRegistry/$(appId)).data.active == true;
    }

    function hasAscensionManagerAccess(uid) {
      let appId = '1:379503088311:web:7b5117cc3447eded133332';
      return authenticatedEmailUser()
        && signedInAs(uid)
        && exists(/databases/$(database)/documents/appRegistry/$(appId))
        && get(/databases/$(database)/documents/appRegistry/$(appId)).data.active == true
        && (
          hasCanonicalAppAccess(uid, appId)
          || (
            !exists(/databases/$(database)/documents/accessUsers/$(uid))
            && exists(/databases/$(database)/documents/invitedEmails/$(request.auth.token.email.lower()))
            && get(/databases/$(database)/documents/invitedEmails/$(request.auth.token.email.lower())).data.active == true
          )
        );
    }

    // Canonical application-owned namespaces.
    match /apps/schoolAcademicsManager/users/{uid}/{document=**} {
      allow read, write: if signedInAs(uid);
    }

    match /apps/ascensionManager/users/{uid}/{document=**} {
      allow read, write: if hasAscensionManagerAccess(uid);
    }

    match /apps/schoolExamsManager/users/{uid}/{document=**} {
      allow read, write: if signedInAs(uid);
    }

    match /apps/schoolFestPro/users/{uid}/{document=**} {
      allow read, write: if hasCanonicalAppAccess(uid, '1:379503088311:web:5774bcc84597b656133332');
    }

    match /apps/schoolBellManager/users/{uid}/{document=**} {
      allow read, write: if signedInAs(uid);
    }

    match /apps/gymTracker/users/{uid}/{document=**} {
      allow read, write: if signedInAs(uid);
    }

    match /apps/collageMaker/users/{uid}/{document=**} {
      allow read, write: if hasCanonicalAppAccess(uid, '1:379503088311:web:6a63dfcd8523e9f8133332');
    }

    match /apps/attendanceManagerWithWaSender/users/{uid}/{document=**} {
      allow read, write: if hasCanonicalAppAccess(uid, '1:379503088311:web:e046f96ed629ffd4133332');
    }

    match /apps/labMetrics/users/{uid}/{document=**} {
      allow read, write: if hasCanonicalAppAccess(uid, '1:379503088311:web:b37328f071189e18133332');
    }

    match /apps/attendanceWaSender/users/{uid}/{document=**} {
      allow read, write: if signedInAs(uid);
    }

    // This application currently has no authentication. Keep access limited to
    // its one fixed document; authentication should be added in a later change.
    match /apps/teachersExamDutyAllotment/data/planner {
      allow read, write: if true;
    }

    // Temporary legacy compatibility. New application code must not use these paths.
    match /users/{uid}/{document=**} {
      allow read, write: if signedInAs(uid);
    }

    match /ascensionManagerUsers/{uid}/{document=**} {
      allow read, write: if hasAscensionManagerAccess(uid);
    }

    match /schoolFestProUsers/{uid}/{document=**} {
      allow read, write: if hasCanonicalAppAccess(uid, '1:379503088311:web:5774bcc84597b656133332');
    }

    match /attendanceManagerUsers/{uid}/{document=**} {
      allow read, write: if hasCanonicalAppAccess(uid, '1:379503088311:web:e046f96ed629ffd4133332');
    }

    match /plannerData/{document=**} {
      allow read, write: if signedIn();
    }

    match /invitedEmails/{email} {
      allow get: if authenticatedEmailUser() && email == request.auth.token.email.lower();
      allow list, create, update, delete: if false;
    }

    // Access Manager control-plane data is server-only.
    match /admins/{document=**} { allow read, write: if false; }
    match /adminInvites/{document=**} { allow read, write: if false; }
    match /accessUsers/{document=**} { allow read, write: if false; }
    match /accessInvites/{document=**} { allow read, write: if false; }
    match /appRegistry/{document=**} { allow read, write: if false; }
    match /accessRequests/{document=**} { allow read, write: if false; }
    match /accessRequestKeys/{document=**} { allow read, write: if false; }
    match /mail/{document=**} { allow read, write: if false; }

    // Preserve the intentional public inauguration workflow.
    match /inaugurationSessions/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.activated == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.activatedAt == null
        && request.resource.data.content is map
        && request.resource.data.theme is map
        && request.resource.data.effects is map;
      allow update: if resource.data.activated == false && (
        (
          request.resource.data.activated == false
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.activatedAt == resource.data.activatedAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'theme', 'effects'])
        )
        || (
          request.resource.data.activated == true
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.activatedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activated', 'activatedAt'])
        )
      );
      allow delete: if false;
    }

    // Preserve unknown authenticated legacy top-level apps temporarily, but
    // explicitly exclude /apps so this compatibility rule cannot bypass any
    // canonical application-specific authorization above.
    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && collection != 'apps'
        && collection != 'users'
        && collection != 'admins'
        && collection != 'adminInvites'
        && collection != 'accessUsers'
        && collection != 'accessInvites'
        && collection != 'appRegistry'
        && collection != 'accessRequests'
        && collection != 'accessRequestKeys'
        && collection != 'mail'
        && collection != 'invitedEmails'
        && collection != 'ascensionManagerUsers'
        && collection != 'schoolFestProUsers'
        && collection != 'attendanceManagerUsers'
        && collection != 'plannerData'
        && collection != 'inaugurationSessions';
    }
  }
}
