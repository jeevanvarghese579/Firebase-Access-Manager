rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticatedUser() {
      return request.auth != null
        && request.auth.token.email != null;
    }

    function ascensionFirebaseAppId() {
      return '1:379503088311:web:7b5117cc3447eded133332';
    }

    function hasCollageMakerAccess(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/accessUsers/$(uid)).data.active == true
        && get(/databases/$(database)/documents/accessUsers/$(uid)).data.apps['1:379503088311:web:6a63dfcd8523e9f8133332'] == true
        && get(/databases/$(database)/documents/appRegistry/1:379503088311:web:6a63dfcd8523e9f8133332).data.active == true;
    }

    function hasAscensionManagerAccess() {
      return isAuthenticatedUser()
        && exists(/databases/$(database)/documents/appRegistry/$(ascensionFirebaseAppId()))
        && get(/databases/$(database)/documents/appRegistry/$(ascensionFirebaseAppId())).data.active == true
        && (
          (
            exists(/databases/$(database)/documents/accessUsers/$(request.auth.uid))
            && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.active == true
            && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.apps[ascensionFirebaseAppId()] == true
          )
          || (
            !exists(/databases/$(database)/documents/accessUsers/$(request.auth.uid))
            && exists(/databases/$(database)/documents/invitedEmails/$(request.auth.token.email.lower()))
            && get(/databases/$(database)/documents/invitedEmails/$(request.auth.token.email.lower())).data.active == true
          )
        );
    }

    // Preserve the currently deployed Collage Maker rule exactly.
    match /users/{uid}/{document=**} {
      allow read, write: if hasCollageMakerAccess(uid);
    }

    match /invitedEmails/{email} {
      allow get: if isAuthenticatedUser() && email == request.auth.token.email.lower();
      allow list, create, update, delete: if false;
    }

    match /ascensionManagerUsers/{userId} {
      allow read, write: if hasAscensionManagerAccess() && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if hasAscensionManagerAccess() && request.auth.uid == userId;
      }
    }

    // Access Manager data is server-only. Every browser request is denied;
    // callable functions use Admin SDK and perform their own authorization.
    match /admins/{document=**} {
      allow read, write: if false;
    }
    match /adminInvites/{document=**} {
      allow read, write: if false;
    }
    match /accessUsers/{document=**} {
      allow read, write: if false;
    }
    match /accessInvites/{document=**} {
      allow read, write: if false;
    }
    match /appRegistry/{document=**} {
      allow read, write: if false;
    }
    match /accessRequests/{document=**} {
      allow read, write: if false;
    }
    match /accessRequestKeys/{document=**} {
      allow read, write: if false;
    }
  }
}
